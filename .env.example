# Numero WhatsApp Business in formato internazionale senza + (es. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (per salvare i contatti del modulo). Non committare mai i valori reali.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Verifica del cellulare via SMS (Twilio Verify). Senza queste variabili, in sviluppo o con OTP_DEMO=1
# la verifica è in modalità prova: nessun SMS, codice 123456.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_DEMO=
